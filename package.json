{
  "name": "ForgeEngine",
  "version": "1.0.0",
  "private": true,
  "description": "ForgeEngine \u2014 browser-based 2D/3D game engine and editor",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "workspaces": [
    "core",
    "utils",
    "2d",
    "3d"
  ],
  "scripts": {
    "start": "node core/index.js",
    "dev": "node core/index.js",
    "test": "echo \"Error: no test specified\"",
    "desktop": "electron .",
    "pack": "electron-builder --dir",
    "dist:win": "electron-builder --win nsis"
  },
  "dependencies": {
    "@ForgeEngine/utils": "^1.0.0",
    "express": "^5.1.0",
    "opentype.js": "^2.0.0"
  },
  "main": "desktop/main.js",
  "devDependencies": {
    "electron": "^43.2.0",
    "electron-builder": "^26.15.7"
  },
  "build": {
    "appId": "com.forgeengine.editor",
    "productName": "ForgeEngine",
    "asar": true,
    "directories": {
      "output": "dist"
    },
    "files": [
      "package.json",
      "desktop/**/*",
      "core/**/*",
      "src/**/*",
      "public/**/*",
      "assets/**/*",
      "utils/**/*",
      "2d/**/*",
      "3d/**/*",
      "!**/*.md",
      "!games/**/*",
      "!.forge/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "ForgeEngine-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "ForgeEngine",
      "deleteAppDataOnUninstall": false
    }
  }
}
